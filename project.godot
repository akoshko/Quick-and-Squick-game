; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="QuickAndSquick"
run/main_scene="res://src/Main.tscn"
run/flush_stdout_on_print=true
config/features=PackedStringArray("4.7", "Mobile")
config/icon="uid://c0yvif4h4sw0c"
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false

[autoload]

Net="*res://src/net/Net.gd"
GameManager="*res://src/autoload/GameManager.gd"
Quests="*res://src/quests/Quests.tscn"
PlayerProfile="*res://src/character/PlayerProfile.gd"
Sfx="*res://src/autoload/Sfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=3
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="QuickAndSquick"

[editor]

naming/scene_name_casing=1

[editor_plugins]

enabled=PackedStringArray()

[gui]

theme/custom="res://assets/GohuTheme.tres"
theme/default_font_multichannel_signed_distance_field=true
theme/default_font_generate_mipmaps=true
theme/default_theme_scale=2.0

